# ⟨fs_type⟩     ⟨mount_point⟩               ⟨fs_options⟩                                           ⟨flags⟩
system          /system                     ext4        ro,barrier=1                               wait,logical,first_stage_mount
vendor          /vendor                     ext4        ro,barrier=1                               wait,logical,first_stage_mount
product         /product                    ext4        ro,barrier=1                               wait,logical,first_stage_mount
odm             /odm                        ext4        ro,barrier=1                               wait,logical,first_stage_mount

/dev/block/bootdevice/by-name/userdata      /data       f2fs        noatime,nosuid,nodev,discard       latemount,wait,check,fileencryption=ice,keydirectory=/metadata/vold/metadata_encryption
/dev/block/bootdevice/by-name/cache         /cache      ext4        noatime,nosuid,nodev,barrier=1     wait,check
/dev/block/bootdevice/by-name/metadata      /metadata   ext4        noatime,nosuid,nodev,barrier=1     wait,formattable,first_stage_mount
/dev/block/bootdevice/by-name/boot          /boot       emmc        defaults                           first_stage_mount
/dev/block/bootdevice/by-name/recovery      /recovery   emmc        defaults                           first_stage_mount
