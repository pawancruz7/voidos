type void_sanitizer, domain, coredomain;
type void_sanitizer_exec, exec_type, file_type, system_file_type;

init_daemon_domain(void_sanitizer)

allow void_sanitizer proc_drop_caches:file { open write getattr };

allow void_sanitizer logdw_socket:sock_file write;
allow void_sanitizer logd:unix_stream_socket connectto;

neverallow { domain -coredomain -init } void_sanitizer:process ptrace;
