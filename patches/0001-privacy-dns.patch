--- a/system/core/rootdir/init.rc
+++ b/system/core/rootdir/init.rc
@@ -1,4 +1,9 @@
 # VoidOS Core Privacy Network Configurations
 on init
-    # Secure DNS fallback activated by default
-    write /proc/sys/net/ipv4/tcp_syncookies 1
+    # Block default corporate DNS tracking — use Quad9 + Cloudflare
+    setprop net.dns1 9.9.9.9
+    setprop net.dns2 1.1.1.1
+    # Redirect connectivity check away from Google servers
+    setprop net.connectivity.check_url "http://localhost"
