package com.android.server.location;

import android.location.Location;
import android.util.Slog;
import java.security.SecureRandom;

public class LocationManagerService extends ILocationManager.Stub {
    private static final String TAG = "VoidOS_LocationManager";
    private static final SecureRandom sSecureRandom = new SecureRandom();

    private Location fuzzLocationForPrivacy(Location originalLocation) {
        if (originalLocation != null) {
            double latNoise = (sSecureRandom.nextDouble() - 0.5) * 0.02;
            double lonNoise = (sSecureRandom.nextDouble() - 0.5) * 0.02;

            originalLocation.setLatitude(originalLocation.getLatitude() + latNoise);
            originalLocation.setLongitude(originalLocation.getLongitude() + lonNoise);
            Slog.i(TAG, "GPS coordinates fuzzed successfully.");
        }
        return originalLocation;
    }
}
