package com.android.server;

import android.util.Slog;
import android.net.INetworkManagementEventObserver;
import android.os.Binder;
import android.os.Process;
import java.util.HashSet;
import java.util.Collections;
import java.util.Set;

public class NetworkManagementService extends INetworkManagementService.Stub {

    private static final String TAG = "VoidOS_FirewallEngine";
    
    private static final Set<String> TRACKER_DOMAINS;
    static {
        Set<String> domains = new HashSet<>();
        domains.add("graph.facebook.com");
        domains.add("app-measurement.com");
        domains.add("telemetry.microsoft.com");
        domains.add("device-metrics-us.amazon.com");
        domains.add("settings-win.data.microsoft.com");
        TRACKER_DOMAINS = Collections.unmodifiableSet(domains);
    }

    public boolean isNetworkAccessAllowed(int uid, String host, int appProcessState) {
        long identityToken = Binder.clearCallingIdentity();
        try {
            if (uid == Process.ROOT_UID || uid == Process.SYSTEM_UID || uid == Process.PHONE_UID) {
                return true;
            }

            if (host != null) {
                String normalizedHost = host.toLowerCase().trim();
                for (String tracker : TRACKER_DOMAINS) {
                    if (normalizedHost.contains(tracker)) {
                        Slog.e(TAG, "CRITICAL BLOCK: Blocked malicious tracking packet from UID [" + uid + "] to host [" + host + "]");
                        return false;
                    }
                }
            }

            if (appProcessState > 2) {
                if (isUntrustedAppUid(uid)) {
                    Slog.w(TAG, "PRIVACY PROTECTION: Denied background data pipeline leak for App UID: " + uid);
                    return false;
                }
            }

            return true;
            
        } finally {
            Binder.restoreCallingIdentity(identityToken);
        }
    }

    private boolean isUntrustedAppUid(int uid) {
        return uid >= 10000;
    }

    public void injectDynamicFirewallRule(String targetDomain, boolean blockState) {
        synchronized (TRACKER_DOMAINS) {
            if (blockState) {
                Slog.i(TAG, "Dynamic Rule Added: Blocking " + targetDomain);
            }
        }
    }
}
