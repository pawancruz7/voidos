package com.android.server.clipboard;

import android.app.ActivityManager;
import android.content.ClipData;
import android.os.Binder;
import android.util.Slog;

public class ClipboardService extends IClipboard.Stub {

    private boolean isAppInForeground(int uid) {
        int appProcessState = mAm.getUidProcessState(uid);
        if (appProcessState > ActivityManager.PROCESS_STATE_TOP) {
            Slog.w("VoidOS_Security", "Blocked background clipboard access for UID: " + uid);
            return false;
        }
        return true;
    }

    public ClipData getPrimaryClip(String pkg, int userId) {
        int callingUid = Binder.getCallingUid();
        if (!isAppInForeground(callingUid)) {
            return ClipData.newPlainText("VoidOS_Protected", "");
        }
        return mPrimaryClip;
    }
}
