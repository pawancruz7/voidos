#include <android/hardware/ICameraService.h>
#include <utils/Log.h>
#include <binder/BinderService.h>
#include <cutils/properties.h>

namespace android {

bool isCameraAccessValid(int callingUid, int appState, const String16& clientPackageName) {
    if (callingUid == 1000 || callingUid == 0) {
        return true;
    }

    if (appState > 4) {
        ALOGE("VoidOS_Shield: SPYWARE ATTEMPT BLOCKED. Package [%s] (UID: %d) attempted background camera hook.", 
              String8(clientPackageName).string(), callingUid);
        
        property_set("sys.voidos.camera.spoof", "1");
        return false;
    }

    property_set("sys.voidos.camera.spoof", "0");
    return true;
}

}
