cc_binary {
    name: "void_sanitizer",

    srcs: ["void_sanitizer.cpp"],

    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
        "-O3",
        "-fstack-protector-strong",
        "-D_FORTIFY_SOURCE=2",
    ],

    shared_libs: [
        "liblog",
        "libutils",
        "libcutils",
    ],

    init_rc: ["void_sanitizer.rc"],

    vendor_available: false,
    system_ext_specific: false,
}
