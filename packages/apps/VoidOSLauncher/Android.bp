android_app {
    name: "VoidOSLauncher",

    srcs: [
        "src/**/*.java",
    ],

    resource_dirs: [
        "res",
    ],

    manifest: "AndroidManifest.xml",

    platform_apis: true,
    certificate: "platform",
    privileged: true,

    optimize: {
        enabled: true,
        proguard_flags_files: ["proguard.flags"],
    },
}
