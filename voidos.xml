<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!-- Remote sources for core AOSP -->
  <remote name="aosp" fetch="https://android.googlesource.com" review="android-review.googlesource.com" />
  <remote name="voidos" fetch="https://github.com/pawancruz7" />

  <!-- Core Android revision to build upon (Android 14/15 Base) -->
  <default revision="refs/tags/android-14.0.0_r50" remote="aosp" sync-j="4" />

  <!-- Core Operating System Components -->
  <project path="build/make" name="platform/build" groups="pdk,tradefed" />
  <project path="bionic" name="platform/bionic" groups="pdk" />
  <project path="system/core" name="platform/system/core" groups="pdk" />
  
  <!-- VoidOS Custom Layer Location -->
  <project path="vendor/voidos" name="voidos" remote="voidos" revision="main" />
</manifest>
